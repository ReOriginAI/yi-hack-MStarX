-#define DEFAULT_JSON_CONF_FILE "/etc/onvif_simple_server.json"
-#define DEFAULT_LOG_FILE "/var/log/onvif_notify_server.log"
+#define DEFAULT_CONF_FILE "/tmp/onvif_simple_server.conf"
+#define DEFAULT_JSON_CONF_FILE "/tmp/onvif_simple_server.json"
+#define DEFAULT_LOG_FILE "/tmp/yi-service-logs/onvif_notify_server.log"
@@ -47 +48 @@
-#define DEFAULT_TEMPLATE_DIR "/etc/onvif_notify_server"
+#define DEFAULT_TEMPLATE_DIR "/home/yi-hack/etc/onvif_notify_server"
@@ -571,0 +573,15 @@ void print_usage(char *progname)
+/* Refuse an uncapped fallback directory even when the mount helper fails.
+ * statfs reports total capacity, not current free space. */
+static FILE *open_bounded_log(void)
+{
+    struct statfs fs;
+    FILE *file = NULL;
+    if (statfs("/tmp/yi-service-logs", &fs) == 0 &&
+        fs.f_type == 0x01021994 && fs.f_blocks > 0 &&
+        (unsigned long long)fs.f_blocks * fs.f_bsize <= 128 * 1024 &&
+        fs.f_files <= 16) file = fopen(DEFAULT_LOG_FILE, "w");
+    if (file == NULL) file = fopen("/dev/null", "w");
+    if (file == NULL) exit(EXIT_FAILURE);
+    return file;
+}
+
@@ -713 +729 @@ int main(int argc, char **argv)  {
-    fLog = fopen(DEFAULT_LOG_FILE, "w");
+    fLog = open_bounded_log();
